{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ashiato-kai-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"d1_databases": [
		{
			"binding": "ashiato_kai",
			"database_name": "ashiato-kai",
			"database_id": "ef19ffbb-1f5b-429f-934f-c2d45de7ebd4"
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none",
		"not_found_handling": "none"
	}
}